{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brand-avoidance:index:1",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["key", "matches"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "matches": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["recordId", "name", "field", "value", "record", "page"],
              "properties": {
                "recordId": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "field": { "enum": ["name", "aliases", "identifiers"] },
                "value": { "type": "string", "minLength": 1 },
                "record": { "$ref": "urn:brand-avoidance:common:1#/$defs/descriptor" },
                "page": { "$ref": "urn:brand-avoidance:common:1#/$defs/descriptor" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
